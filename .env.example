# ──────────────────────────────────────────────────────────────
# Gravitas Campus Platform — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ──────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
APP_ENV=development                 # development | test | production

# Database (any PostgreSQL 15+). On Supabase use the *transaction pooler* URL (port 6543).
# On AWS use the RDS / RDS Proxy URL. The app connects as this user and drops to the
# restricted role `app_user` for every request, so Row Level Security always applies.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gravitas
DATABASE_POOL_MAX=5
DATABASE_SSL=false                  # true on Supabase / RDS

# Sessions — 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Pepper mixed into IP hashes in logs (privacy). Generate like SESSION_SECRET.
HASH_PEPPER=change-me-too

# File storage (S3 protocol). Supabase Storage and AWS S3 both speak it.
STORAGE_DRIVER=local                # local | s3
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=                        # Supabase: https://<ref>.supabase.co/storage/v1/s3 ; AWS: leave empty
S3_REGION=ap-south-1
S3_BUCKET=gravitas-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true            # true for Supabase, false for AWS

# Email
EMAIL_DRIVER=console                # console | resend
EMAIL_FROM="Gravitas Campus <no-reply@example.com>"
RESEND_API_KEY=

# AI (Phase 2)
AI_PROVIDER=mock                    # mock | openai
OPENAI_API_KEY=

# Payments (Phase 3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Secret for scheduled jobs (/api/cron/*). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Demo seed password for staff/adult demo accounts (dev/test environments only)
SEED_DEMO_PASSWORD=Gravitas@2026
